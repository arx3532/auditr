# FastAPI base URL (no trailing slash). Required unless NEXT_PUBLIC_USE_MOCKS=true.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Leave false for any real deployment. Set true only for local development against MSW
# fixtures (and for the Playwright e2e run, which sets it itself).
NEXT_PUBLIC_USE_MOCKS=false

# Clerk (see https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
