# FastAPI base URL (no trailing slash). Required unless NEXT_PUBLIC_USE_MOCKS=true.
NEXT_PUBLIC_API_URL=http://localhost:8000

# When true, MSW serves fixture data instead of calling the API.
NEXT_PUBLIC_USE_MOCKS=true

# Clerk (see https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
